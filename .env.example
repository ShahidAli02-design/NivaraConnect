# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. Used to send account-approval and
# maintenance-bill emails via the Resend API (resend.com — sign up, an API
# key is generated for you, no SMTP setup). If left unset, email
# notifications are silently skipped — nothing else breaks.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# RESEND_FROM_EMAIL: Optional. Defaults to Resend's shared sandbox address,
# which can only deliver to the email that owns the Resend account. Once a
# sending domain is verified on Resend, point this at that domain (e.g.
# "NivaraConnect <notifications@yourdomain.com>") to email any recipient.
RESEND_FROM_EMAIL="NivaraConnect <onboarding@resend.dev>"
